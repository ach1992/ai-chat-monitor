{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "None",
    "moduleResolution": "Classic",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,
    "sourceMap": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/chrome.d.ts",
    "src/content/**/*.ts"
  ]
}
